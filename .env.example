# Copy to .env for local development:  cp .env.example .env
#
# In Azure, the CI workflow provisions these: the secret below becomes a
# Container App secret, and the deployment identity comes from GitHub
# secrets/variables. Nothing here is committed with real values.
#
# Public protocol constants (Solana cluster, program ID, TTLs, issuer) are NOT
# listed here — they have committed defaults in oracle/settings.py and only
# need setting to override them. See docs/deployment/keys-and-secrets.md.

# ─────────────────────────────────────────────────────────────────────────────
# SECRET — the only true secret this service holds
# ─────────────────────────────────────────────────────────────────────────────
# Oracle identity: 32-byte Ed25519 seed, hex encoded.
#
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
#
# The service REFUSES TO START without it (see the startup check in app.py),
# which also logs the derived public key. That public key must be pinned into
# the measured enclave image as ORACLE_PUBKEY_HEX — rotating this seed changes
# MRENCLAVE and destroys all sealed enclave state.
ORACLE_SIGNING_KEY_HEX=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT IDENTITY — required only for the Azure VM deployment endpoints
# (/deployments, /vms). The oracle routes do not need any of these.
# ─────────────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=westeurope
AZURE_VNET_NAME=
AZURE_SUBNET_NAME=

# Public half of the SSH key used for the SGX VMs:  ssh-keygen -t ed25519
SSH_PUBLIC_KEY=

# Container image the deployer runs on the SGX VM. Built and published by the
# trusted-compute-MVP enclave CI; deploy by digest, not by tag.
SGX_IMAGE=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL OVERRIDES — defaults in oracle/settings.py are correct for devnet
# ─────────────────────────────────────────────────────────────────────────────
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_CLUSTER=devnet
# DRT_PROGRAM_ID=CME2Dg7UEW82Hf99rQetEi7Hc5Db9JQPx6Azmx1eWbEE
# ORACLE_ASSERTION_TTL=300
# ORACLE_MAX_CLAIM_TTL=900
# ORACLE_ISSUER=relational-oracle-1
# ORACLE_KEY_ID=oracle-1
# ORACLE_RPC_TIMEOUT_SECONDS=15
